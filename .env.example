# OAuth client IDs (never commit real secrets)
NOVAMAIL_GOOGLE_CLIENT_ID=
NOVAMAIL_GOOGLE_CLIENT_SECRET=
NOVAMAIL_MS_CLIENT_ID=
NOVAMAIL_MS_CLIENT_SECRET=
NOVAMAIL_YAHOO_CLIENT_ID=
NOVAMAIL_YAHOO_CLIENT_SECRET=

# Local AI (Ollama)
NOVAMAIL_AI_PROVIDER=ollama
NOVAMAIL_OLLAMA_URL=http://127.0.0.1:11434
# Default: qwen3:4b-instruct — low-spec/CPU: qwen2.5:1.5b
NOVAMAIL_OLLAMA_MODEL=qwen3:4b-instruct

# Logging
RUST_LOG=novamail=info,novamail_desktop=info
