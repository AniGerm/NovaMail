{
  "name": "novamail",
  "private": true,
  "version": "0.1.16",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @novamail/desktop tauri:dev",
    "build": "pnpm --filter @novamail/desktop tauri:build",
    "lint": "pnpm --filter @novamail/desktop lint",
    "typecheck": "pnpm --filter @novamail/desktop typecheck",
    "test:rust": "cargo test --workspace",
    "desktop:dev": "pnpm --filter @novamail/desktop dev",
    "desktop:build": "pnpm --filter @novamail/desktop build",
    "desktop:install-launcher": "bash scripts/install-desktop-launcher.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
